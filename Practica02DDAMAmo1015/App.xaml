<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Practica02DDAMAmo1015.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Application.Resources>

        <!-- ============================= -->
        <!--   RECURSOS GLOBALES DINÁMICOS -->
        <!-- ============================= -->

        <!-- Tamaño global del texto -->
        <x:Double x:Key="GlobalFontSize">20</x:Double>

        <!-- Color global del texto -->
        <Color x:Key="GlobalFontColor">Black</Color>

        <!-- Fuente global -->
        <x:String x:Key="GlobalFontFamily">OpenSansRegular</x:String>


        <!-- ============================= -->
        <!--   ESTILO GLOBAL IMPLÍCITO     -->
        <!-- ============================= -->
        <!-- Este estilo se aplica a TODOS los Label automáticamente -->
        <!-- No tiene x:Key → es implícito -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}" />
            <Setter Property="TextColor" Value="{DynamicResource GlobalFontColor}" />
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
        </Style>

    </Application.Resources>

</Application>
