<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Practica02DDAMAmo1015.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Inicio">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

            <Image Source="dotnet_bot.png"
                   HeightRequest="180"
                   HorizontalOptions="Center" />

            <Label Style="{StaticResource TituloLabel}"
                   Text="Bienvenido a la aplicación" />

            <Label Text="Usa el menú lateral o los botones de abajo para navegar."
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray" />

            <Button Text="Ir a la Galería" Clicked="OnGaleriaClicked" />
            <Button Text="Ir a Configuración" Clicked="OnConfigClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
