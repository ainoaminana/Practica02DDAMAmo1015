<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Practica02DDAMAmo1015.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login">

    <!--
        Página de inicio de sesión.
        Permite autenticación mediante usuario/contraseña o mediante huella dactilar.
    -->

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <!-- Título -->
        <Label Style="{StaticResource TituloLabel}"
               Text="Iniciar sesión" />

        <!-- Entrada de usuario -->
        <Entry x:Name="UsernameEntry"
               Placeholder="Usuario" />

        <!-- Entrada de contraseña -->
        <Entry x:Name="PasswordEntry"
               Placeholder="Contraseña"
               IsPassword="True" />

        <!-- Botón de acceso manual -->
        <Button Text="Acceder"
                Clicked="OnLoginClicked" />

        <!-- Botón de acceso biométrico -->
        <Button Text="Acceder con huella"
                Clicked="OnFingerprintClicked" />

    </VerticalStackLayout>

</ContentPage>