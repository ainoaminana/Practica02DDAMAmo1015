<ContentPage
    x:Class="Practica02amo1015.Views.GaleriaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Galería">

    <CollectionView x:Name="AnimalesView" SelectionMode="Single" SelectionChanged="OnAnimalSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="10" Margin="10">
                    <VerticalStackLayout>
                        <Image Source="{Binding Imagen}" HeightRequest="120" />
                        <Label Text="{Binding Nombre}" FontSize="18" />
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
