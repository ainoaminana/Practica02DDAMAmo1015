<ContentPage
    x:Class="Practica02DDAMAmo1015.Views.GaleriaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Galería">

    <CollectionView x:Name="AnimalesView"
                    SelectionMode="Single"
                    SelectionChanged="OnAnimalSelected">

        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="2" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="10" Margin="10" CornerRadius="12" HasShadow="True">
                    <VerticalStackLayout>
                        <Image Source="{Binding Imagen}" HeightRequest="120" Aspect="AspectFill" />
                        <Label Text="{Binding Nombre}"
                               HorizontalOptions="Center"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
