<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Practica02DDAMAmo1015.Views.DetalleAnimalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalles">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Image x:Name="ImagenAnimal"
                   HeightRequest="250"
                   Aspect="AspectFill"
                   HorizontalOptions="Center" />

            <Label x:Name="NombreAnimal"
                   Style="{StaticResource TituloLabel}" />

            <Label x:Name="DescripcionAnimal"
                   FontSize="20"
                   TextColor="{StaticResource AzulBoton}"
                   HorizontalTextAlignment="Center" />

            <Button Text="Volver" Clicked="OnVolverClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
